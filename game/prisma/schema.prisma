generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Preset {
  id                String    @id @default(uuid())
  name              String
  description       String
  startDate         String
  simulationRules   String    @default("")
  worldLore         String    @default("")
  defaultDifficulty String    @default("normal")
  regions           Region[]
  countries         Country[]
  points            Point[]
  games             Game[]
}

model Game {
  id              String               @id @default(uuid())
  presetId        String
  preset          Preset               @relation(fields: [presetId], references: [id])
  playerCountryId String
  currentDate     String
  round           Int                  @default(1)
  aiModel         String               @default("stub")
  difficulty      String               @default("normal")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          Event[]
  actions         Action[]
  chatThreads     ChatThread[]
  consolidations  ConsolidationSummary[]
  gameRegions     GameRegion[]
  gameCountries   GameCountry[]
  gamePoints      GamePoint[]
}

model Region {
  id             String @id @default(uuid())
  presetId       String
  preset         Preset @relation(fields: [presetId], references: [id])
  name           String
  type           String @default("land")
  geometry       String
  ownerCountryId String?
  neighborIds    String @default("[]")
}

model GameRegion {
  id             String @id @default(uuid())
  gameId         String
  game           Game   @relation(fields: [gameId], references: [id])
  regionId       String
  name           String
  type           String @default("land")
  geometry       String
  ownerCountryId String?
  neighborIds    String @default("[]")
}

model Country {
  id              String @id @default(uuid())
  presetId        String
  preset          Preset @relation(fields: [presetId], references: [id])
  name            String
  color           String
  flag            String @default("")
  capitalRegionId String?
  leaderName      String @default("")
  stats           String @default("{}")
  relations       String @default("{}")
}

model GameCountry {
  id              String @id @default(uuid())
  gameId          String
  game            Game   @relation(fields: [gameId], references: [id])
  countryId       String
  name            String
  color           String
  flag            String @default("")
  capitalRegionId String?
  leaderName      String @default("")
  stats           String @default("{}")
  relations       String @default("{}")
}

model Point {
  id             String  @id @default(uuid())
  presetId       String
  preset         Preset  @relation(fields: [presetId], references: [id])
  type           String
  regionId       String
  coordX         Float
  coordY         Float
  ownerCountryId String?
  label          String  @default("")
  strength       Int     @default(0)
  locked         Boolean @default(false)
}

model GamePoint {
  id             String  @id @default(uuid())
  gameId         String
  game           Game    @relation(fields: [gameId], references: [id])
  pointId        String
  type           String
  regionId       String
  coordX         Float
  coordY         Float
  ownerCountryId String?
  label          String  @default("")
  strength       Int     @default(0)
  locked         Boolean @default(false)
}

model Event {
  id            String @id @default(uuid())
  gameId        String
  game          Game   @relation(fields: [gameId], references: [id])
  round         Int
  date          String
  category      String
  title         String
  body          String
  appliedDeltas String @default("[]")
}

model Action {
  id     String @id @default(uuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])
  round  Int
  text   String
  status String @default("pending")
}

model ChatThread {
  id                    String        @id @default(uuid())
  gameId                String
  game                  Game          @relation(fields: [gameId], references: [id])
  kind                  String        @default("bilateral")
  participantCountryIds String        @default("[]")
  messages              ChatMessage[]
}

model ChatMessage {
  id               String     @id @default(uuid())
  threadId         String
  thread           ChatThread @relation(fields: [threadId], references: [id])
  round            Int
  role             String
  speakerCountryId String?
  text             String
  createdAt        DateTime   @default(now())
}

model ConsolidationSummary {
  id          String @id @default(uuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id])
  fromRound   Int
  toRound     Int
  summaryText String
}
