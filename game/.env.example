# Database
DATABASE_URL="file:./dev.db"

# LLM Provider Configuration
# Set LLM_PROVIDER to enable AI-powered simulation (otherwise uses deterministic stub)
# Options: openai, anthropic, openrouter
# LLM_PROVIDER=openai

# Model to use (required when LLM_PROVIDER is set)
# LLM_MODEL=gpt-4o

# API Keys (set the one matching your provider)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Custom base URL (optional, for self-hosted or alternative endpoints)
# LLM_BASE_URL=https://api.example.com/v1
